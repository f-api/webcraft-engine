+describe("remote crouching presentation", () => {
+  it("keeps the feet fixed, updates manual matrices and armor, and restores the standing rig after a swing", () => {
+    vi.stubGlobal("document", { createElement: () => ({ width: 0, height: 0,
+      getContext: () => ({ fillRect: () => {}, fillText: () => {} }) }) });
+    const player = new RemotePlayer("Steve", new Texture());
+    const batcher = new MobInstanceBatcher();
+    try {
+      player.bindBatches(batcher, 1);
+      const pose = { x: 2, y: 64, z: 3, yaw: 0, pitch: 0, moving: false };
+      const rig = player as unknown as {
+        head: Object3D; body: Object3D; leftLeg: Object3D; rightLeg: Object3D;
+        leftArm: Object3D; rightArm: Object3D; nameTag: Object3D; bubble: Object3D;
+        ensureArmorAnchors(): { head: Object3D; body: Object3D };
+      };
+      player.update(pose, 0);
+      const nodes = [rig.head, rig.body, rig.leftArm, rig.rightArm, rig.nameTag, rig.bubble];
+      const standing = nodes.map((node) => node.matrix.clone());
+      const feet = [rig.leftLeg.matrix.clone(), rig.rightLeg.matrix.clone()];
+      expect(player.setCrouching(true)).toBe(true);
+      player.update(pose, 0);
+      expect(player.group.position.y).toBe(64);
+      expect(rig.head.position.y).toBeCloseTo(1.27);
+      expect(rig.body.rotation.x).toBeLessThan(0);
+      expect(rig.leftLeg.matrix.equals(feet[0])).toBe(true);
+      expect(rig.rightLeg.matrix.equals(feet[1])).toBe(true);
+      nodes.forEach((node, index) => {
+        expect(node.matrixAutoUpdate).toBe(false);
+        expect(node.matrix.elements[13]).toBeLessThan(standing[index].elements[13]);
+      });
+      // 장비를 웅크린 뒤 추가해도 현재 리그를 따라야 한다.
+      const armor = rig.ensureArmorAnchors();
+      expect(armor.head.matrix.equals(rig.head.matrix)).toBe(true);
+      expect(armor.body.matrix.equals(rig.body.matrix)).toBe(true);
+      const shoulderY = rig.rightArm.position.y;
+      player.swing("main");
+      player.update(pose, 0.15);
+      expect(rig.body.rotation.y).not.toBe(0);
+      expect(rig.rightArm.position.y).toBe(shoulderY);
+      expect(rig.leftArm.position.y).toBe(shoulderY);
+      expect(armor.body.matrix.equals(rig.body.matrix)).toBe(true);
+      expect(player.setCrouching(true)).toBe(false);
+      player.update(pose, 0.2);
+      expect(player.setCrouching(false)).toBe(true);
+      player.update(pose, 0);
+      nodes.forEach((node, index) => expect(node.matrix.equals(standing[index])).toBe(true));
+      expect(armor.head.matrix.equals(rig.head.matrix)).toBe(true);
+      expect(armor.body.matrix.equals(rig.body.matrix)).toBe(true);
+      // 기존 앵커도 자세 전환 즉시 수동 행렬을 갱신한다.
+      player.setCrouching(true);
+      player.update(pose, 0);
+      expect(armor.head.matrix.equals(rig.head.matrix)).toBe(true);
+      expect(armor.body.matrix.equals(rig.body.matrix)).toBe(true);
+    } finally {
+      player.dispose();
+      vi.unstubAllGlobals();
+    }
+  });
+});
