--- /dev/null
+++ b/client/src/world/AssignmentLootClient.test.ts
@@ -0,0 +1,37 @@
+import { describe, expect, it } from "vitest";
+import { BAMBOO_HANGING_SIGN, BLOCK_ID_HIGH_WATER, PROTOCOL_ID_HIGH_WATER } from "./blocks";
+import { blockMeta } from "./BlockRegistry";
+import { itemName, stackMax } from "../ui/items";
+import { BAMBOO_HANGING_SIGN_ICON } from "../ui/bambooHangingSignIcon";
+import { SOUND_PROFILES } from "../audio/SemanticSoundRegistry";
+import { validStandaloneArchaeologyStewComponent } from "../backend/standalone/StandaloneSuspiciousStew";
+
+describe("engine loot client compatibility", () => {
+  it("registers bamboo hanging signs without replacing an existing protocol ID", () => {
+    expect(BAMBOO_HANGING_SIGN).toBe(2516);
+    expect(BLOCK_ID_HIGH_WATER).toBeGreaterThanOrEqual(BAMBOO_HANGING_SIGN);
+    expect(PROTOCOL_ID_HIGH_WATER).toBeGreaterThanOrEqual(BAMBOO_HANGING_SIGN);
+    expect(blockMeta(BAMBOO_HANGING_SIGN)).toMatchObject({ shape: "banner", solid: false });
+    expect(itemName(BAMBOO_HANGING_SIGN)).toBe("대나무 매달린 팻말");
+    expect(stackMax(BAMBOO_HANGING_SIGN)).toBe(16);
+    expect(BAMBOO_HANGING_SIGN_ICON.rows).toHaveLength(16);
+    expect(BAMBOO_HANGING_SIGN_ICON.rows.every(row => row.length === 16)).toBe(true);
+  });
+
+  it("plays eight stable instrument variants through the records bus", () => {
+    const instruments = ["ponder", "sing", "seek", "feel", "admire", "call", "yearn", "dream"];
+    const profiles = instruments.map(name => SOUND_PROFILES[`item.goat_horn.play.${name}`]);
+    profiles.forEach(profile => expect(profile).toMatchObject({ bus: "record", range: 256, policy: "one-shot" }));
+    expect(new Set(profiles.map(profile => `${profile.samples[0]}:${profile.playbackRate}`)).size).toBe(8);
+    expect(SOUND_PROFILES["item.goat_horn.play"]).toBeDefined();
+  });
+
+  it("accepts instant saturation loot ticks while retaining archaeology values", () => {
+    [7, 8, 9, 10, 140, 160, 180, 200].forEach(durationMcTicks => {
+      expect(validStandaloneArchaeologyStewComponent({ effect: "saturation", durationMcTicks })).toBe(true);
+    });
+    [6, 11, 141].forEach(durationMcTicks => {
+      expect(validStandaloneArchaeologyStewComponent({ effect: "saturation", durationMcTicks })).toBe(false);
+    });
+  });
+});
